<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LE ROULV — The Unseen Style</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Raleway:wght@100;200;300;400&display=swap');

  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

  :root {
    --ink: #0d1b2e;
    --gold: #c9a96e;
    --gold-light: #e8d5a3;
    --cream: #f5f0e8;
    --off-white: #faf8f4;
    --charcoal: #1a1a1a;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--charcoal);
    color: var(--cream);
    font-family: 'Raleway', sans-serif;
    font-weight: 200;
    overflow-x: hidden;
    cursor: none;
  }

  /* CUSTOM CURSOR */
  .cursor {
    position: fixed; width:8px; height:8px;
    background: var(--gold); border-radius:50%;
    pointer-events:none; z-index:9999;
    transform: translate(-50%,-50%);
    transition: transform 0.1s, width 0.3s, height 0.3s, background 0.3s;
    mix-blend-mode: difference;
  }
  .cursor-ring {
    position:fixed; width:32px; height:32px;
    border:1px solid rgba(201,169,110,0.4);
    border-radius:50%; pointer-events:none; z-index:9998;
    transform:translate(-50%,-50%);
    transition: all 0.18s ease;
  }

  /* NAV */
  nav {
    position: fixed; top:0; left:0; right:0; z-index:100;
    display:flex; align-items:center; justify-content:space-between;
    padding: 28px 48px;
    mix-blend-mode: normal;
    transition: all 0.6s ease;
  }
  nav.scrolled { background: rgba(26,26,26,0.85); backdrop-filter: blur(20px); padding:18px 48px; }

  .nav-logo {
    display:flex; align-items:center; gap:12px;
    font-family:'Raleway',sans-serif; font-weight:100;
    font-size:13px; letter-spacing:0.35em; color:var(--cream);
    text-decoration:none;
  }
  .nav-logo svg { width:28px; height:40px; }

  .nav-links { display:flex; gap:40px; }
  .nav-links a {
    font-size:10px; letter-spacing:0.3em; color:rgba(245,240,232,0.55);
    text-decoration:none; text-transform:uppercase;
    transition: color 0.3s;
  }
  .nav-links a:hover { color:var(--gold); }

  /* HERO */
  #hero {
    position:relative; height:100vh;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center;
    overflow:hidden;
    background: radial-gradient(ellipse 60% 70% at 50% 40%, #0d1b2e 0%, #0a0a0a 100%);
  }

  .hero-bg-lines {
    position:absolute; inset:0; overflow:hidden; opacity:0.06;
  }
  .hero-bg-lines::before {
    content:'';
    position:absolute; inset:0;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 79px, rgba(201,169,110,0.5) 80px),
      repeating-linear-gradient(90deg, transparent, transparent 79px, rgba(201,169,110,0.5) 80px);
  }

  /* 3D LOGO CANVAS */
  #logoCanvas {
    display:block; margin:0 auto;
    filter: drop-shadow(0 0 30px rgba(201,169,110,0.15));
  }

  .hero-title {
    font-family:'Cormorant Garamond', serif;
    font-size: clamp(52px, 9vw, 120px);
    font-weight:300; letter-spacing:0.22em;
    color: var(--cream);
    margin-top: 24px;
    opacity:0; animation: fadeUp 1.4s 0.8s forwards;
  }

  .hero-sub {
    font-size:10px; letter-spacing:0.5em; color:var(--gold);
    text-transform:uppercase; margin-top:10px;
    opacity:0; animation: fadeUp 1.4s 1.1s forwards;
  }

  .hero-quote {
    font-family:'Cormorant Garamond',serif; font-style:italic;
    font-size:clamp(13px,1.4vw,17px); color:rgba(245,240,232,0.4);
    margin-top:32px; max-width:440px; text-align:center;
    opacity:0; animation: fadeUp 1.4s 1.4s forwards;
  }

  .descend {
    position:absolute; bottom:48px;
    display:flex; flex-direction:column; align-items:center; gap:10px;
    font-size:9px; letter-spacing:0.4em; color:rgba(245,240,232,0.3);
    text-transform:uppercase;
    opacity:0; animation: fadeUp 1.4s 1.8s forwards;
  }
  .descend-line {
    width:1px; height:40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: pulse-line 2s infinite;
  }

  @keyframes fadeUp {
    from { opacity:0; transform:translateY(24px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes pulse-line {
    0%,100% { opacity:0.3; } 50% { opacity:1; }
  }

  /* SECTIONS */
  section {
    min-height:100vh; padding:120px 0;
    display:flex; align-items:center; justify-content:center;
    position:relative; overflow:hidden;
  }

  section:nth-child(even) { background: #111; }
  section:nth-child(odd):not(#hero) { background: #0d0d0d; }

  .section-inner {
    max-width:1100px; width:100%; padding:0 48px;
    display:grid; gap:80px;
  }

  .section-label {
    font-size:9px; letter-spacing:0.5em; color:var(--gold);
    text-transform:uppercase; margin-bottom:16px;
  }

  .section-title {
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(36px,5vw,72px); font-weight:300;
    letter-spacing:0.05em; line-height:1.1;
  }

  .section-body {
    font-size:14px; line-height:2; color:rgba(245,240,232,0.55);
    max-width:520px; font-weight:300;
  }

  /* PILLARS GRID */
  .pillars {
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px;
    background: rgba(201,169,110,0.1);
    border:1px solid rgba(201,169,110,0.1);
    margin-top:80px;
  }
  .pillar {
    padding:56px 40px; background:#0d0d0d;
    border-bottom:1px solid rgba(201,169,110,0.08);
    transition: background 0.4s;
  }
  .pillar:hover { background: rgba(201,169,110,0.03); }
  .pillar-num {
    font-family:'Cormorant Garamond',serif;
    font-size:48px; font-weight:300; color:rgba(201,169,110,0.15);
    display:block; margin-bottom:24px;
  }
  .pillar-title {
    font-size:10px; letter-spacing:0.3em; text-transform:uppercase;
    color:var(--cream); margin-bottom:16px;
  }
  .pillar-text {
    font-size:13px; line-height:1.9;
    color:rgba(245,240,232,0.45);
  }

  /* GENESIS SPLIT */
  .genesis-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:120px;
    align-items:center;
  }
  .genesis-visual {
    display:flex; align-items:center; justify-content:center;
  }
  .genesis-symbol {
    width:200px; height:200px;
    border:1px solid rgba(201,169,110,0.2);
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    position:relative;
    animation: rotate-slow 20s linear infinite;
  }
  .genesis-symbol::before {
    content:''; position:absolute; inset:16px;
    border:1px solid rgba(201,169,110,0.1);
    border-radius:50%;
    animation: rotate-slow 15s linear infinite reverse;
  }
  @keyframes rotate-slow { to { transform:rotate(360deg); } }

  /* MATERIAL */
  .material-list {
    display:grid; grid-template-columns:1fr 1fr; gap:0;
    border-top:1px solid rgba(201,169,110,0.12);
    margin-top:48px;
  }
  .material-item {
    padding:32px 0; border-bottom:1px solid rgba(201,169,110,0.08);
    display:flex; justify-content:space-between; align-items:center;
    font-size:12px; letter-spacing:0.2em; text-transform:uppercase;
    color:rgba(245,240,232,0.5);
    transition: color 0.3s;
    cursor:default;
  }
  .material-item:hover { color:var(--gold); }
  .material-item:nth-child(odd) { padding-right:48px; border-right:1px solid rgba(201,169,110,0.08); }
  .material-item:nth-child(even) { padding-left:48px; }

  /* CONTACT */
  #contact {
    background: var(--ink) !important;
    min-height:60vh;
  }
  .contact-inner {
    text-align:center; display:flex; flex-direction:column;
    align-items:center; gap:24px;
  }
  .contact-links {
    display:flex; gap:48px; margin-top:32px;
  }
  .contact-link {
    font-size:9px; letter-spacing:0.4em; text-transform:uppercase;
    color:rgba(245,240,232,0.4); text-decoration:none;
    transition: color 0.3s;
    padding-bottom:4px;
    border-bottom:1px solid transparent;
  }
  .contact-link:hover { color:var(--gold); border-bottom-color:var(--gold); }

  .footer-rule {
    width:100%; height:1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.3), transparent);
    margin:80px 0 40px;
  }
  .footer-text {
    font-size:9px; letter-spacing:0.3em; color:rgba(245,240,232,0.2);
    text-align:center; padding-bottom:48px;
  }

  /* SCROLL REVEAL */
  .reveal { opacity:0; transform:translateY(32px); transition: opacity 0.9s ease, transform 0.9s ease; }
  .reveal.visible { opacity:1; transform:translateY(0); }

  /* GOLD LINE DIVIDER */
  .gold-divider {
    width:40px; height:1px;
    background: var(--gold); margin-bottom:32px;
  }

  @media(max-width:768px) {
    nav { padding:20px 24px; }
    .nav-links { display:none; }
    .section-inner { padding:0 24px; }
    .pillars { grid-template-columns:1fr; }
    .genesis-grid { grid-template-columns:1fr; gap:48px; }
    .material-list { grid-template-columns:1fr; }
    .material-item:nth-child(odd) { padding-right:0; border-right:none; }
    .material-item:nth-child(even) { padding-left:0; }
  }
</style>
</head>
