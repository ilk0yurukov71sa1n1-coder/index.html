<script>
// CURSOR
const cursor = document.getElementById('cursor');
const ring = document.getElementById('cursorRing');
let mx=0, my=0, rx=0, ry=0;
document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; cursor.style.left=mx+'px'; cursor.style.top=my+'px'; });
(function animRing(){ rx+=(mx-rx)*0.12; ry+=(my-ry)*0.12; ring.style.left=rx+'px'; ring.style.top=ry+'px'; requestAnimationFrame(animRing); })();
document.querySelectorAll('a,button,.pillar,.material-item').forEach(el => {
  el.addEventListener('mouseenter',()=>{ cursor.style.width='14px'; cursor.style.height='14px'; ring.style.width='48px'; ring.style.height='48px'; });
  el.addEventListener('mouseleave',()=>{ cursor.style.width='8px'; cursor.style.height='8px'; ring.style.width='32px'; ring.style.height='32px'; });
});

// NAV SCROLL
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => { nav.classList.toggle('scrolled', window.scrollY > 60); });

// SCROLL REVEAL
const reveals = document.querySelectorAll('.reveal');
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
}, { threshold:0.12 });
reveals.forEach(r => io.observe(r));

// 3D LOGO ON CANVAS — Three.js via CDN
(function loadThree(){
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
  s.onload = initLogo;
  document.head.appendChild(s);
})();

function initLogo() {
  const canvas = document.getElementById('logoCanvas');
  const W = canvas.width, H = canvas.height;
  const renderer = new THREE.WebGLRenderer({ canvas, alpha:true, antialias:true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
  renderer.setSize(W, H);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, W/H, 0.1, 100);
  camera.position.set(0, 0, 7);

  // Lights
  const ambient = new THREE.AmbientLight(0xffffff, 0.3);
  scene.add(ambient);
  const dirLight = new THREE.DirectionalLight(0xc9a96e, 2.5);
  dirLight.position.set(3, 5, 5);
  scene.add(dirLight);
  const rimLight = new THREE.DirectionalLight(0x4488cc, 0.8);
  rimLight.position.set(-4, -2, 2);
  scene.add(rimLight);
  const ptLight = new THREE.PointLight(0xc9a96e, 1.5, 20);
  ptLight.position.set(0, 2, 4);
  scene.add(ptLight);

  // Material — metallic gold
  const mat = new THREE.MeshStandardMaterial({
    color: 0xc9a96e,
    metalness: 0.9,
    roughness: 0.15,
    envMapIntensity: 1
  });

  const tubeMat = new THREE.MeshStandardMaterial({
    color: 0xc9a96e,
    metalness: 0.85,
    roughness: 0.2,
  });

  const group = new THREE.Group();

  // Helper: tube from point A to B
  function tube(ax,ay,az, bx,by,bz, r=0.04){
    const pts = [new THREE.Vector3(ax,ay,az), new THREE.Vector3(bx,by,bz)];
    const curve = new THREE.CatmullRomCurve3(pts);
    const geo = new THREE.TubeGeometry(curve, 4, r, 8, false);
    const m = new THREE.Mesh(geo, tubeMat);
    group.add(m);
    return m;
  }

  // Helper: curve tube from array of points
  function curveTube(points, r=0.04){
    const v3 = points.map(p => new THREE.Vector3(p[0],p[1],p[2]));
    const curve = new THREE.CatmullRomCurve3(v3);
    const geo = new THREE.TubeGeometry(curve, 20, r, 8, false);
    const m = new THREE.Mesh(geo, tubeMat);
    group.add(m);
  }

  // SCALE: logo fits roughly -2 to 2 in x, -3 to 3 in y
  // Cross at top
  tube(0, 2.7, 0,   0, 2.2, 0);        // vertical
  tube(-0.35,2.5,0, 0.35,2.5,0);       // horizontal

  // Head (small sphere)
  const headGeo = new THREE.SphereGeometry(0.13, 16, 16);
  const head = new THREE.Mesh(headGeo, mat);
  head.position.set(0, 2.0, 0);
  group.add(head);

  // Spine / body
  tube(0, 1.87, 0,  0, 0.1, 0, 0.05);

  // Left arm
  tube(0, 1.2, 0,  -0.8, 1.35, 0, 0.04);

  // R curve (right arm + bowl)
  curveTube([
    [0, 1.2, 0],
    [0.6, 1.3, 0.1],
    [1.0, 1.1, 0.08],
    [1.0, 0.8, 0],
    [0.7, 0.6, -0.05],
    [0, 0.55, 0]
  ], 0.04);

  // R leg diagonal (kick-leg of R)
  curveTube([
    [0, 0.55, 0],
    [0.5, 0.2, 0.05],
    [1.0, -0.3, 0]
  ], 0.04);

  // Left leg
  curveTube([
    [0, 0.1, 0],
    [-0.25, -0.6, 0.05],
    [-0.45, -1.4, 0]
  ], 0.045);

  // Right leg
  curveTube([
    [0, 0.1, 0],
    [0.2, -0.5, 0.05],
    [0.35, -1.2, 0]
  ], 0.045);

  // Left foot
  tube(-0.45, -1.4, 0,  -0.85, -1.6, 0, 0.035);

  // Small loop at base (the decorative swirl from original)
  curveTube([
    [-0.85, -1.6, 0],
    [-1.05, -1.75, 0.05],
    [-0.95, -1.9, 0],
    [-0.75, -1.85, 0],
    [-0.7, -1.7, 0]
  ], 0.03);

  // Right foot
  tube(0.35, -1.2, 0,  0.7, -1.45, 0, 0.035);

  // Floating particles
  const particleGeo = new THREE.BufferGeometry();
  const pCount = 60;
  const pPos = new Float32Array(pCount*3);
  for(let i=0;i<pCount;i++){
    pPos[i*3]   = (Math.random()-0.5)*5;
    pPos[i*3+1] = (Math.random()-0.5)*7;
    pPos[i*3+2] = (Math.random()-0.5)*3;
  }
  particleGeo.setAttribute('position', new THREE.BufferAttribute(pPos,3));
  const pMat = new THREE.PointsMaterial({ color:0xc9a96e, size:0.025, transparent:true, opacity:0.4 });
  const particles = new THREE.Points(particleGeo, pMat);
  scene.add(particles);

  scene.add(group);

  // Subtle intro animation
  group.scale.set(0,0,0);
  let entered = false;

  // Mouse interaction
  let targetRotY = 0, targetRotX = 0, currentRotY = 0, currentRotX = 0;
  document.addEventListener('mousemove', e => {
    targetRotY = (e.clientX / window.innerWidth - 0.5) * 0.6;
    targetRotX = (e.clientY / window.innerHeight - 0.5) * -0.3;
  });

  // Touch
  document.addEventListener('touchmove', e => {
    targetRotY = (e.touches[0].clientX / window.innerWidth - 0.5) * 0.6;
  });

  let t = 0;
  function animate(){
    requestAnimationFrame(animate);
    t += 0.008;

    // Scale in
    if(!entered){
      group.scale.x += (1-group.scale.x)*0.06;
      group.scale.y += (1-group.scale.y)*0.06;
      group.scale.z += (1-group.scale.z)*0.06;
      if(group.scale.x > 0.99) entered = true;
    }

    // Smooth rotation follow mouse
    currentRotY += (targetRotY - currentRotY) * 0.05;
    currentRotX += (targetRotX - currentRotX) * 0.05;

    group.rotation.y = currentRotY + Math.sin(t*0.4)*0.05;
    group.rotation.x = currentRotX + Math.sin(t*0.3)*0.02;
    group.rotation.z = Math.sin(t*0.2)*0.015;

    // Gentle float
    group.position.y = Math.sin(t*0.5)*0.07;

    // Light pulse
    ptLight.intensity = 1.2 + Math.sin(t)*0.4;

    // Particles drift
    particles.rotation.y = t*0.02;
    particles.rotation.x = t*0.01;

    renderer.render(scene, camera);
  }
  animate();
}
</script>
</body>
</html>
