{
  "name": "rollcfluence-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rollcfluence HQ: one private app on your Mac that runs the business.",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1 -p 3900",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1 -p 3900",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test --test-reporter=spec core/*.test.ts modules/*/lib/*.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "motion": "^14.2.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
