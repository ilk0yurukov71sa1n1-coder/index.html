// THREE.JS — DEEP WATER SHADER BACKGROUND
// ═══════════════════════════════════════════════
const bgCanvas = document.getElementById('bg');
const renderer = new THREE.WebGLRenderer({canvas:bgCanvas,antialias:false});
renderer.setPixelRatio(Math.min(window.devicePixelRatio,1.5));
renderer.setSize(window.innerWidth,window.innerHeight);

const scene = new THREE.Scene();
const cam = new THREE.OrthographicCamera(-1,1,1,-1,0,1);

const vShader = `varying vec2 vUv; void main(){vUv=uv;gl_Position=vec4(position.xy,0.,1.);}`;
const fShader = `
precision mediump float;
uniform float time;
uniform vec2 res;
uniform float depth;
varying vec2 vUv;

float h21(vec2 p){p=fract(p*vec2(127.34,311.78));p+=dot(p,p+45.12);return fract(p.x*p.y);}
float sn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(h21(i),h21(i+vec2(1,0)),f.x),mix(h21(i+vec2(0,1)),h21(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<6;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}

void main(){
  vec2 uv = vUv;
  float t = time * .05 + depth * .3;

  vec2 q = vec2(fbm(uv*2.+vec2(0.,t*.6)),fbm(uv*2.+vec2(5.2,t*.5)));
  vec2 r = vec2(fbm(uv*1.8+3.8*q+vec2(1.7,t*.4)),fbm(uv*1.8+3.8*q+vec2(9.2,t*.3)));
  float n = fbm(uv*1.2+3.5*r+t*.2);

  // Deep water palette — dark navy to near-black
  vec3 c0 = vec3(.003,.006,.016); // void
  vec3 c1 = vec3(.007,.015,.038); // very deep navy
  vec3 c2 = vec3(.012,.028,.072); // deep water
  vec3 c3 = vec3(.020,.048,.110); // lighter deep

  vec3 col = mix(c0,c1,smoothstep(.0,.25,n));
  col = mix(col,c2,smoothstep(.25,.55,n));
  col = mix(col,c3,smoothstep(.55,.8,n)*.55);

  // Gold caustic shimmer — very subtle
  float gc = smoothstep(.72,.9,n);
  col += vec3(.025,.018,.005)*gc*.6;

  // Animated caustic lines
  float cx = uv.x + fbm(uv*9.+t)*0.08;
  float cy = uv.y + fbm(uv.yx*7.+t*.9)*0.08;
  float caus = max(0.,sin(cx*22.+t*2.8)*sin(cy*16.-t*1.4))*.011;
  col += vec3(caus*.2,caus*.35,caus*.9)*.35;

  // Scroll-depth darkening — as we go deeper water gets darker
  col *= 1. - depth * .25;

  // Soft vignette
  float v = uv.x*(1.-uv.x)*uv.y*(1.-uv.y)*5.;
  col *= pow(max(v,.001),.35);

  gl_FragColor = vec4(col,1.);
}
`;

const mat = new THREE.ShaderMaterial({
  vertexShader: vShader,
  fragmentShader: fShader,
  uniforms: {
    time: {value:0},
    res:  {value: new THREE.Vector2(window.innerWidth, window.innerHeight)},
    depth:{value:0}
  }
});
const quad = new THREE.Mesh(new THREE.PlaneGeometry(2,2), mat);
scene.add(quad);

let scrollProgress = 0;
window.addEventListener('scroll', () => {
  scrollProgress = window.scrollY / (document.body.scrollHeight - window.innerHeight);
});

let frameT = 0;
(function bgLoop(){
  frameT += 0.016;
  mat.uniforms.time.value = frameT;
  mat.uniforms.depth.value += (scrollProgress - mat.uniforms.depth.value) * 0.04;
  renderer.render(scene, cam);
  requestAnimationFrame(bgLoop);
})();

window.addEventListener('resize', () => {
  renderer.setSize(window.innerWidth, window.innerHeight);
  mat.uniforms.res.value.set(window.innerWidth, window.innerHeight);
});

