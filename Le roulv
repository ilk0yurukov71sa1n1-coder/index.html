// AI ASSISTANT
// ═══════════════════════════════════════════════
const aiBtn = document.getElementById('ai-btn');
const aiModal = document.getElementById('ai-modal');
const aiX = document.getElementById('ai-x');
const aiIn = document.getElementById('ai-in');
const aiGo = document.getElementById('ai-go');
const aiMsgs = document.getElementById('ai-msgs');

aiBtn.addEventListener('click', () => aiModal.classList.toggle('open'));
aiX.addEventListener('click', () => aiModal.classList.remove('open'));

function addMsg(txt, role){
  const d = document.createElement('div');
  d.className = `ai-msg ${role}`;
  d.textContent = txt;
  aiMsgs.appendChild(d);
  aiMsgs.scrollTop = aiMsgs.scrollHeight;
  return d;
}

async function sendMsg(){
  const txt = aiIn.value.trim();
  if(!txt) return;
  aiIn.value = '';
  addMsg(txt, 'user');
  const loader = addMsg('', 'assistant typing');

  const sysFr = lang === 'fr'
    ? 'Répondez en français, avec poésie et concision.'
    : 'Respond in English, with poetic precision.';

  const system = `You are the spirit of Le Roulv — a luxury minimalist brand born at 3:33 AM on September 29, 2025. Le Roulv means The Dream (Le Rêve in French). Your philosophy: "Do not worry for the cost; worry for the style that is not seen." You believe Rarity is a Promise. The brand was created by a young, godly-minded entrepreneur and dreamer. The brand's star material is nettle fiber (Urtica dioica) — an ancient textile revived for modern luxury. Speak with calm authority, poetic restraint, and spiritual depth. Keep responses to 2–4 beautifully crafted sentences. Never be verbose. ${sysFr}`;

  try{
    const resp = await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:1000,
        system,
        messages:[{role:'user',content:txt}]
      })
    });
    const data = await resp.json();
    const reply = data.content?.map(c=>c.text||'').join('')||'The unseen cannot always be spoken.';
    loader.classList.remove('typing');
    loader.textContent = reply;
  } catch(e){
    loader.classList.remove('typing');
    loader.textContent = 'The river flows in silence. Please try again.';
  }
}

aiGo.addEventListener('click', sendMsg);
aiIn.addEventListener('keydown', e => { if(e.key==='Enter') sendMsg(); });

