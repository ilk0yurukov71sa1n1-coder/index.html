<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Le Roulv — The Unseen Style</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;0,400;0,500;1,200;1,300;1,400;1,500&family=Raleway:wght@100;200;300;400&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --void:#030608;
  --deep:#050d1a;
  --navy:#071224;
  --gold:#c8a86a;
  --gold-dim:rgba(200,168,106,0.35);
  --gold-faint:rgba(200,168,106,0.08);
  --ink:#0d1b50;
  --white:#f2ede4;
  --white-dim:rgba(242,237,228,0.55);
  --white-faint:rgba(242,237,228,0.2);
}
html{scroll-behavior:smooth;font-size:16px}
body{
  background:var(--void);
  color:var(--white);
  font-family:'Raleway',sans-serif;
  font-weight:300;
  overflow-x:hidden;
  cursor:none;
}

/* CURSOR */
#cur,#cur-r{position:fixed;top:0;left:0;border-radius:50%;pointer-events:none;z-index:9999}
#cur{width:7px;height:7px;background:var(--gold);margin:-3.5px 0 0 -3.5px}
#cur-r{width:36px;height:36px;border:1px solid var(--gold-dim);margin:-18px 0 0 -18px;transition:width .4s,height .4s,opacity .4s}
body:has(a:hover) #cur-r,body:has(button:hover) #cur-r{width:60px;height:60px;opacity:.5}

/* CANVAS BG */
#bg{position:fixed;inset:0;z-index:0;width:100%;height:100%}

/* GRAIN OVERLAY */
#grain{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E")}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:2.2rem 4rem;backdrop-filter:blur(2px)}
.nav-logo-svg{width:28px;height:38px;overflow:visible}
.nav-wordmark{font-family:'Cormorant Garamond',serif;font-size:.85rem;font-weight:300;letter-spacing:.55em;text-transform:uppercase;color:var(--white);margin-left:.8rem}
.nav-left{display:flex;align-items:center;gap:0}
.nav-right{display:flex;align-items:center;gap:2.5rem}
.lang-wrap{display:flex;align-items:center;gap:.4rem}
.lang-btn{background:none;border:none;font-family:'Raleway',sans-serif;font-size:.6rem;font-weight:400;letter-spacing:.25em;text-transform:uppercase;color:var(--white-faint);cursor:none;padding:.2rem .4rem;transition:color .3s}
.lang-btn.on{color:var(--gold)}
.lang-btn:hover{color:var(--white-dim)}
.lang-sep{color:var(--white-faint);font-size:.5rem}
.nav-link{font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--white-faint);text-decoration:none;cursor:none;transition:color .3s}
.nav-link:hover{color:var(--white)}

/* MAIN */
main{position:relative;z-index:2}

/* ====== HERO ====== */
#hero{height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden}
.hero-inner{display:flex;flex-direction:column;align-items:center;text-align:center;gap:0}
.hero-logo-svg{
  width:140px;height:190px;
  filter:drop-shadow(0 0 60px rgba(200,168,106,.18)) drop-shadow(0 0 20px rgba(200,168,106,.12));
  animation:breathe 10s ease-in-out infinite;
  cursor:none;
}
@keyframes breathe{
  0%,100%{transform:translateY(0) rotate(-0.5deg) scale(1)}
  35%{transform:translateY(-14px) rotate(.8deg) scale(1.02)}
  65%{transform:translateY(-8px) rotate(-.3deg) scale(1.015)}
}
.hero-rule{width:1px;height:40px;background:linear-gradient(to bottom,transparent,var(--gold-dim));margin:2.2rem 0 1.8rem}
.hero-brand{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(3.5rem,8.5vw,7.5rem);
  font-weight:200;
  letter-spacing:.45em;
  text-transform:uppercase;
  color:var(--white);
  line-height:1;
  text-indent:.45em; /* compensate letter-spacing on last char */
}
.hero-sub{
  font-size:.58rem;letter-spacing:.55em;color:var(--gold);text-transform:uppercase;
  font-weight:400;margin-top:1rem;text-indent:.55em;
}
.hero-tagline{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:1rem;color:var(--white-dim);
  margin-top:2.8rem;line-height:1.75;max-width:520px;
  letter-spacing:.02em;
}
.scroll-cue{position:absolute;bottom:3.2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.7rem}
.scroll-line{width:1px;height:56px;background:linear-gradient(to bottom,transparent,var(--gold));animation:scpulse 2.4s ease-in-out infinite}
@keyframes scpulse{0%,100%{opacity:.3;transform:scaleY(.7) translateY(-6px)}50%{opacity:1;transform:scaleY(1) translateY(0)}}
.scroll-label{font-size:.5rem;letter-spacing:.45em;color:var(--gold);text-transform:uppercase;text-indent:.45em}

/* ====== SHARED SECTION STYLES ====== */
.sect{position:relative;z-index:2}
.sect-pad{max-width:1240px;margin:0 auto;padding:10rem 5rem}
.s-label{
  display:flex;align-items:center;gap:1.4rem;
  font-size:.55rem;letter-spacing:.55em;color:var(--gold);text-transform:uppercase;
  margin-bottom:2.2rem;font-weight:400;
}
.s-label::before{content:'';width:36px;height:1px;background:var(--gold);flex-shrink:0}
.s-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(2.4rem,4.5vw,4.2rem);
  font-weight:300;line-height:1.12;color:var(--white);
  margin-bottom:2rem;
}
.s-body{
  font-size:.88rem;line-height:1.95;color:var(--white-dim);
  font-weight:300;max-width:580px;
}
.sect-divider{width:100%;height:1px;background:linear-gradient(to right,transparent,var(--gold-dim),transparent);margin:0}

/* ====== GENESIS ====== */
#genesis{background:linear-gradient(to bottom,rgba(5,13,26,.4),rgba(5,13,26,.65),rgba(5,13,26,.4))}
.genesis-grid{display:grid;grid-template-columns:1fr 1fr;gap:9rem;align-items:center}
.genesis-time-bg{
  font-family:'Cormorant Garamond',serif;font-size:clamp(5rem,10vw,8rem);
  font-weight:200;color:rgba(200,168,106,.07);line-height:1;
  margin-bottom:-1.5rem;letter-spacing:-.02em;
}
.genesis-card{
  border:1px solid rgba(200,168,106,.12);padding:3.5rem 3rem;position:relative;
  backdrop-filter:blur(4px);background:rgba(5,13,26,.3);
}
.genesis-card::before,.genesis-card::after{
  content:'';position:absolute;left:3rem;right:3rem;height:1px;
  background:linear-gradient(to right,transparent,var(--gold-dim),transparent);
}
.genesis-card::before{top:0}
.genesis-card::after{bottom:0}
.genesis-quote{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:1.08rem;line-height:1.85;color:var(--white-dim);
}
.genesis-attr{margin-top:2rem;font-size:.55rem;letter-spacing:.4em;color:var(--gold);text-transform:uppercase}

/* ====== PHILOSOPHY — horizontal ====== */
#philosophy{overflow:hidden;background:rgba(3,6,8,.2)}
.phil-head{max-width:1240px;margin:0 auto;padding:8rem 5rem 3rem}
.phil-track{display:flex;gap:3.5rem;padding:3rem 5rem 8rem;width:max-content}
.phil-card{
  width:360px;flex-shrink:0;
  border:1px solid rgba(200,168,106,.1);
  padding:3rem 2.8rem;
  position:relative;overflow:hidden;
  background:rgba(5,13,26,.25);backdrop-filter:blur(6px);
  transition:border-color .4s;
}
.phil-card:hover{border-color:rgba(200,168,106,.3)}
.phil-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(to right,transparent,var(--gold-dim),transparent);
}
.phil-num{
  font-family:'Cormorant Garamond',serif;font-size:4.5rem;font-weight:200;
  color:rgba(200,168,106,.07);line-height:1;margin-bottom:1.5rem;
}
.phil-card-title{
  font-family:'Cormorant Garamond',serif;font-size:1.7rem;font-weight:300;
  color:var(--white);margin-bottom:1rem;line-height:1.2;
}
.phil-card-text{font-size:.8rem;line-height:1.85;color:var(--white-dim)}

/* ====== MATERIAL — NETTLE ====== */
#material{background:linear-gradient(to bottom,transparent,rgba(200,168,106,.02),transparent)}
.material-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:9rem;align-items:center}
.material-vis{
  aspect-ratio:3/4;border:1px solid rgba(200,168,106,.1);
  position:relative;overflow:hidden;
}
#nettle-c{width:100%;height:100%;display:block}
.mat-badge{
  position:absolute;bottom:1.8rem;left:1.8rem;
  font-size:.5rem;letter-spacing:.35em;color:var(--gold);text-transform:uppercase;
  border:1px solid rgba(200,168,106,.25);padding:.55rem 1rem;
  background:rgba(3,6,8,.6);backdrop-filter:blur(4px);
}
.mat-stats{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:3rem}
.mat-stat-label{font-size:.5rem;letter-spacing:.4em;color:var(--gold);text-transform:uppercase;margin-bottom:.5rem}
.mat-stat-val{font-size:.82rem;line-height:1.65;color:var(--white-dim)}

/* ====== AESTHETIC ====== */
#aesthetic{text-align:center}
.aes-inner{max-width:1240px;margin:0 auto;padding:10rem 5rem 0}
.aes-quote{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:clamp(1.4rem,2.8vw,2.4rem);font-weight:300;line-height:1.6;
  max-width:780px;margin:0 auto 1.5rem;color:var(--white);
}
.aes-attr{font-size:.55rem;letter-spacing:.5em;color:var(--gold);text-transform:uppercase}
.aes-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:1px;margin-top:7rem;
  background:rgba(200,168,106,.08);
}
.aes-cell{
  background:var(--void);padding:3.5rem 2.5rem;
  position:relative;overflow:hidden;
  transition:background .4s;
}
.aes-cell:hover{background:rgba(5,13,26,.8)}
.aes-cell::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(200,168,106,.04) 0%,transparent 60%);
  opacity:0;transition:opacity .4s;
}
.aes-cell:hover::after{opacity:1}
.aes-cell-title{
  font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:300;
  color:var(--white);margin-bottom:.9rem;
}
.aes-cell-text{font-size:.78rem;line-height:1.8;color:var(--white-dim)}

/* ====== CONTACT ====== */
#contact{text-align:center}
.contact-inner{max-width:600px;margin:0 auto;padding:10rem 2rem 8rem}
.cta-btn{
  display:inline-block;margin-top:3rem;
  padding:1.1rem 4rem;
  border:1px solid var(--gold);
  font-family:'Raleway',sans-serif;font-size:.6rem;font-weight:400;
  letter-spacing:.45em;color:var(--gold);text-transform:uppercase;
  cursor:none;text-decoration:none;
  transition:background .4s,color .4s;
  text-indent:.45em;
}
.cta-btn:hover{background:var(--gold);color:var(--void)}

/* FOOTER */
footer{
  border-top:1px solid rgba(200,168,106,.08);
  padding:2.5rem 5rem;display:flex;justify-content:space-between;align-items:center;
  position:relative;z-index:2;backdrop-filter:blur(4px);
}
.ft-brand{font-family:'Cormorant Garamond',serif;font-size:.85rem;font-weight:300;letter-spacing:.35em;color:var(--white-dim)}
.ft-copy{font-size:.55rem;letter-spacing:.15em;color:var(--white-faint)}
.ft-links{display:flex;gap:2rem}
.ft-link{font-size:.55rem;letter-spacing:.3em;text-transform:uppercase;color:var(--white-faint);text-decoration:none;cursor:none;transition:color .3s}
.ft-link:hover{color:var(--gold)}

/* ====== AI ASSISTANT ====== */
#ai-btn{
  position:fixed;bottom:3rem;right:3rem;z-index:200;
  width:54px;height:54px;border-radius:50%;
  border:1px solid var(--gold-dim);background:rgba(5,13,26,.85);
  display:flex;align-items:center;justify-content:center;
  cursor:none;backdrop-filter:blur(12px);
  transition:transform .3s,background .3s,box-shadow .3s;
  box-shadow:0 0 0 rgba(200,168,106,0);
}
#ai-btn:hover{transform:scale(1.08);background:rgba(200,168,106,.08);box-shadow:0 0 30px rgba(200,168,106,.12)}
#ai-btn svg{width:20px;height:20px;stroke:var(--gold);fill:none;stroke-width:1.4}

#ai-modal{
  position:fixed;bottom:8.5rem;right:3rem;width:380px;
  max-height:520px;z-index:200;
  border:1px solid rgba(200,168,106,.18);
  background:rgba(4,8,14,.93);backdrop-filter:blur(20px);
  display:none;flex-direction:column;overflow:hidden;
  box-shadow:0 40px 80px rgba(0,0,0,.6);
}
#ai-modal.open{display:flex}
.ai-head{padding:1.6rem 1.8rem;border-bottom:1px solid rgba(200,168,106,.1);display:flex;justify-content:space-between;align-items:flex-start}
.ai-title{font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:300;color:var(--white)}
.ai-sub{font-size:.5rem;letter-spacing:.35em;color:var(--gold);text-transform:uppercase;margin-top:.2rem}
.ai-x{background:none;border:none;color:var(--white-faint);cursor:none;font-size:1.3rem;line-height:1;transition:color .3s;padding:0}
.ai-x:hover{color:var(--white)}
.ai-msgs{flex:1;overflow-y:auto;padding:1.4rem 1.8rem;display:flex;flex-direction:column;gap:1rem;scrollbar-width:thin;scrollbar-color:var(--gold-dim) transparent}
.ai-msg{font-size:.8rem;line-height:1.75;padding:.9rem 1.1rem}
.ai-msg.user{background:rgba(200,168,106,.07);border-left:2px solid var(--gold);color:var(--white-dim);align-self:flex-end;max-width:88%;font-size:.78rem}
.ai-msg.assistant{color:var(--white-dim);font-family:'Cormorant Garamond',serif;font-size:.95rem;border-left:2px solid rgba(200,168,106,.18)}
.ai-msg.typing::after{content:'...';animation:blink 1.2s infinite}
@keyframes blink{0%,100%{opacity:.3}50%{opacity:1}}
.ai-input-row{padding:1rem 1.8rem;border-top:1px solid rgba(200,168,106,.1);display:flex;gap:.8rem;align-items:center}
#ai-in{
  flex:1;background:none;border:none;border-bottom:1px solid rgba(200,168,106,.18);
  color:var(--white);font-size:.78rem;font-family:'Raleway',sans-serif;font-weight:300;
  padding:.4rem 0;outline:none;
}
#ai-in::placeholder{color:var(--white-faint)}
#ai-go{
  background:none;border:1px solid rgba(200,168,106,.25);
  color:var(--gold);font-size:.55rem;letter-spacing:.25em;
  padding:.5rem .9rem;cursor:none;text-transform:uppercase;
  font-family:'Raleway',sans-serif;font-weight:400;transition:background .3s;
}
#ai-go:hover{background:rgba(200,168,106,.1)}

/* REVEAL */
.rv{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.rv.show{opacity:1;transform:translateY(0)}
.rv-d1{transition-delay:.12s}
.rv-d2{transition-delay:.22s}
.rv-d3{transition-delay:.34s}

/* ===LOGO particles=== */
.logo-particle{position:absolute;border-radius:50%;pointer-events:none;animation:pf var(--dur) var(--delay) ease-in-out infinite alternate}
@keyframes pf{from{transform:translate(var(--tx1),var(--ty1));opacity:var(--oa)}to{transform:translate(var(--tx2),var(--ty2));opacity:var(--ob)}}

/* RESPONSIVE */
@media(max-width:900px){
  nav{padding:1.6rem 2rem}
  .sect-pad,.phil-head{padding:6rem 2rem}
  .phil-track{padding:2rem 2rem 6rem}
  .genesis-grid,.material-grid{grid-template-columns:1fr;gap:4rem}
  .aes-grid{grid-template-columns:1fr}
  footer{padding:2rem}
  #ai-modal{width:calc(100vw - 2rem);right:1rem}
}
@media(max-width:600px){
  .hero-brand{font-size:2.8rem}
  .genesis-card{padding:2rem 1.5rem}
}
</style>
</head>
<body>

<div id="cur"></div>
<div id="cur-r"></div>
<div id="grain"></div>
<canvas id="bg"></canvas>

<!-- NAV -->
<nav>
  <div class="nav-left">
    <svg class="nav-logo-svg" viewBox="0 0 180 240">
      <defs>
        <filter id="ink-nav">
          <feTurbulence type="fractalNoise" baseFrequency=".07" numOctaves="3" seed="8" result="n"/>
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
      </defs>
      <g filter="url(#ink-nav)" stroke="var(--gold)" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity=".9">
        <path d="M 72 42 C 68 36 65 29 72 26 C 79 23 86 28 82 36"/>
        <path d="M 60 34 C 66 31 73 32 80 36"/>
        <path d="M 82 36 C 88 30 94 29 96 33"/>
        <path d="M 80 44 C 80 52 81 60 82 68"/>
        <path d="M 82 68 C 80 90 78 112 76 134 C 75 152 74 165 72 178"/>
        <path d="M 82 68 C 96 56 118 52 136 64 C 150 74 150 92 140 104 C 130 116 112 120 92 118"/>
        <path d="M 92 118 C 104 130 118 148 132 166 C 140 176 147 186 150 196"/>
        <path d="M 72 178 C 68 192 62 206 56 220"/>
        <path d="M 56 220 C 52 226 48 228 50 222"/>
        <path d="M 150 196 C 153 204 150 210 144 208"/>
      </g>
    </svg>
    <span class="nav-wordmark" data-k="brand">Le Roulv</span>
  </div>
  <div class="nav-right">
    <div class="lang-wrap">
      <button class="lang-btn on" data-lang="en">EN</button>
      <span class="lang-sep">·</span>
      <button class="lang-btn" data-lang="fr">FR</button>
    </div>
    <a href="#genesis" class="nav-link" data-k="nav.genesis">Genesis</a>
    <a href="#material" class="nav-link" data-k="nav.material">Material</a>
    <a href="#contact" class="nav-link" data-k="nav.contact">Contact</a>
  </div>
</nav>

<main>

<!-- ═══════════ HERO ═══════════ -->
<section id="hero" class="sect">
  <div class="hero-inner">

    <!-- LE ROULV LOGO — exact hand-drawn R figure -->
    <div style="position:relative;display:inline-block" id="logo-wrap">
      <svg class="hero-logo-svg" viewBox="0 0 180 240" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Ink roughness filter -->
          <filter id="ink-h" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency=".055" numOctaves="4" seed="7" result="n"/>
            <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4" xChannelSelector="R" yChannelSelector="G"/>
          </filter>
          <!-- Gold glow -->
          <filter id="glow-h" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur"/>
            <feColorMatrix in="blur" type="matrix"
              values="1 0 0 0 0.78   0 0.66 0 0 0.42   0 0 0.27 0 0   0 0 0 0.35 0" result="cb"/>
            <feMerge><feMergeNode in="cb"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="glow-outer" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="14" result="big-blur"/>
            <feColorMatrix in="big-blur" type="matrix"
              values="1 0 0 0 0.78   0 0.66 0 0 0.42   0 0 0.27 0 0   0 0 0 0.18 0"/>
          </filter>
        </defs>
        <!-- Outer glow layer -->
        <g filter="url(#glow-outer)">
          <g stroke="#c8a86a" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 72 42 C 68 36 65 29 72 26 C 79 23 86 28 82 36"/>
            <path d="M 82 68 C 96 56 118 52 136 64 C 150 74 150 92 140 104 C 130 116 112 120 92 118"/>
            <path d="M 92 118 C 104 130 118 148 132 166 C 140 176 147 186 150 196"/>
          </g>
        </g>
        <!-- Main ink layer with roughness + glow -->
        <g filter="url(#glow-h)">
        <g filter="url(#ink-h)" stroke="#0d1b50" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <!-- Hat / head detail top-left -->
          <path d="M 72 42 C 68 36 65 29 72 26 C 79 23 86 28 82 36"/>
          <!-- Hat brim horizontal sweep -->
          <path d="M 60 34 C 66 31 73 32 80 36"/>
          <!-- Right extension from head -->
          <path d="M 82 36 C 88 30 94 29 96 33"/>
          <!-- Neck connecting head to body -->
          <path d="M 80 44 C 80 52 81 60 82 68"/>
          <!-- MAIN BODY — vertical stroke of R -->
          <path d="M 82 68 C 80 90 78 112 76 134 C 75 152 74 165 72 178"/>
          <!-- BOWL of R — right arm sweeping -->
          <path d="M 82 68 C 96 56 118 52 136 64 C 150 74 150 92 140 104 C 130 116 112 120 92 118"/>
          <!-- DIAGONAL LEG of R -->
          <path d="M 92 118 C 104 130 118 148 132 166 C 140 176 147 186 150 196"/>
          <!-- LEFT LEG going down -->
          <path d="M 72 178 C 68 192 62 206 56 220"/>
          <!-- Left foot curl -->
          <path d="M 56 220 C 52 226 48 228 50 222"/>
          <!-- Right foot detail -->
          <path d="M 150 196 C 153 204 150 210 144 208"/>
        </g>
        </g>
      </svg>
    </div>

    <div class="hero-rule"></div>
    <h1 class="hero-brand" data-k="brand">Le Roulv</h1>
    <p class="hero-sub" data-k="hero.sub">The Unseen Style</p>
    <p class="hero-tagline" data-k="hero.tagline">"Do not worry for the cost; worry for the style that is not seen."</p>
  </div>
