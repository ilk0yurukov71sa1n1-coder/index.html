// NETTLE CANVAS — animated fiber texture
// ═══════════════════════════════════════════════
(function initNettle(){
  const nc = document.getElementById('nettle-c');
  const p = nc.parentElement;
  function rsz(){ nc.width=p.offsetWidth; nc.height=p.offsetHeight; }
  rsz();
  window.addEventListener('resize', rsz);
  const ctx = nc.getContext('2d');
  let t2 = 0;
  const FIBERS = 80;
  const seeds = Array.from({length:FIBERS},(_,i)=>({
    x: (i*137.5)%1,
    yS: Math.random()*.2,
    yL: .45+Math.random()*.4,
    wave: Math.random()*Math.PI*2,
    spd: .25+Math.random()*.35,
    amp: 6+Math.random()*10,
    w: .4+Math.random()*.8,
    gold: i%9===0,
    alpha: .1+Math.random()*.18
  }));

  function draw(){
    const w=nc.width, h=nc.height;
    ctx.fillStyle='rgba(3,6,12,1)'; ctx.fillRect(0,0,w,h);
    seeds.forEach(s => {
      const x = s.x * w;
      const yS = s.yS * h, yE = yS + s.yL * h;
      ctx.beginPath(); ctx.moveTo(x, yS);
      for(let y=yS; y<yE; y+=3){
        const xo = Math.sin(y*.048 + t2*s.spd + s.wave) * s.amp;
        ctx.lineTo(x+xo, y);
      }
      if(s.gold){
        ctx.strokeStyle=`rgba(200,168,106,${s.alpha+.12})`;
      } else {
        const r=90+Math.floor(s.x*60), g=110+Math.floor(s.x*30), b=155+Math.floor(s.x*40);
        ctx.strokeStyle=`rgba(${r},${g},${b},${s.alpha})`;
      }
      ctx.lineWidth=s.w; ctx.stroke();
    });
    // depth overlay
    const grd = ctx.createLinearGradient(0,0,0,h);
    grd.addColorStop(0,'rgba(3,6,12,.75)');
    grd.addColorStop(.38,'rgba(3,6,12,.05)');
    grd.addColorStop(.65,'rgba(3,6,12,.05)');
    grd.addColorStop(1,'rgba(3,6,12,.82)');
    ctx.fillStyle=grd; ctx.fillRect(0,0,w,h);
    t2+=.01; requestAnimationFrame(draw);
  }
  draw();
})();

