# Copy to .env.local for local work. Never commit real values.
# All of these are server-only (no VITE_ prefix). On Vercel they are added
# automatically when you connect Supabase and Upstash under Storage.

# Supabase: stores waitlist signups (tables in supabase/setup.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis: rate limits the signup endpoint
# (the Vercel integration may name these KV_REST_API_URL / KV_REST_API_TOKEN; both work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
