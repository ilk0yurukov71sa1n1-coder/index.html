# Copy to .env.local for local work. Never commit real values.
# All of these are server-only (no VITE_ prefix). On Vercel they are added
# automatically when you connect Supabase and Upstash under Storage.

# Supabase: stores waitlist signups (tables in supabase/setup.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis: rate limits the signup endpoint
# (the Vercel integration may name these KV_REST_API_URL / KV_REST_API_TOKEN; both work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (resend.com): verification emails to signups and alerts to the team
RESEND_API_KEY=
# Any long random string; signs the confirmation links
VERIFY_SECRET=
# Optional. Defaults: Rollcfluence <onboarding@resend.dev> and rollcfluence@gmail.com
# Sending to people other than you needs a verified domain in Resend.
MAIL_FROM=
NOTIFY_EMAIL=
